# Copy this file to .env and fill in your real values. .env is gitignored.

# Render Postgres "External Database URL" (Dashboard -> your database -> Connect)
DATABASE_URL=postgres://user:password@host:5432/dbname

# AWS credentials for Bedrock (only needed locally; Render reads these from its
# own environment variable settings instead)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
